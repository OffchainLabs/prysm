package a

import (
	"errors"

	"github.com/sirupsen/logrus"
)

var log = logrus.WithField("package", "a")

func formats() {
	log.Info("Plain message")                   // want `Infof has no format arguments: use Info`
	log.WithError(errors.New("x")).Error("Bad") // want `Errorf has no format arguments: use Error`
	logrus.Info("Package func")                 // want `Infof has no format arguments: use Info`
	log.Infof("Slot %d", 1)
	args := []any{1}
	log.Infof("Slot %d", args...)
	log.Info("Plain message")
}
