diff --color -urN a/BUILD.bazel b/BUILD.bazel
--- a/BUILD.bazel	1969-12-31 18:00:00.000000000 -0600
+++ b/BUILD.bazel	2026-08-06 12:00:00.000000000 +0000
@@ -0,0 +1,17 @@
+load("@prysm//tools/go:def.bzl", "go_library")
+
+# Constantine's KZG bindings. The Nim-generated C they are compiled against lives
+# in clib, which this package blank-imports so cgo links it in.
+#
+# Generated build files are off for this repository (see deps.bzl): the cgo
+# directives use ${SRCDIR}, which gazelle copies verbatim into copts where it does
+# not resolve. Keeping the directives in the sources and the headers in srcs lets
+# cgo expand ${SRCDIR} itself.
+go_library(
+    name = "go_default_library",
+    srcs = ["constantine.go"] + glob(["include/**/*.h"]),
+    cgo = True,
+    importpath = "github.com/nalepae/go-constantine",
+    visibility = ["//visibility:public"],
+    deps = ["//clib:go_default_library"],
+)
